---
/**
 * Site header: logo, primary navigation, search link.
 *
 * Sticky on desktop, static on mobile — a sticky bar costs roughly 12% of a
 * phone's viewport, which on a game site is 12% less game.
 */
import { SITE } from '@/config/site';
import { getMainNav } from '@/lib/content/navigation';
import type { NavLink } from '@/config/nav';

import MobileNav from './MobileNav.astro';

const currentPath: string = Astro.url.pathname;

/** Resolved from live content so a link can never point at an ungenerated route. */
const mainNav: NavLink[] = await getMainNav();

/** A nav link is "current" for its own page and for anything beneath it. */
function isCurrent(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container-content site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${SITE.name} home`}>
      <span class="site-header__mark" aria-hidden="true">SA</span>
      <span class="site-header__name">{SITE.name}</span>
    </a>

    <nav class="site-header__nav" aria-label="Main navigation">
      <ul class="site-header__list">
        {
          mainNav.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-header__link"
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/search/" class="site-header__search tap-target" aria-label="Search games">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
          <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path>
        </svg>
        <span class="site-header__search-text">Search</span>
      </a>
      <MobileNav />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }

  @media (min-width: 1024px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 30;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 60px;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-ink);
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__logo:hover {
    text-decoration: none;
  }

  .site-header__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--color-brand);
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .site-header__nav {
    display: none;
    flex: 1;
  }

  @media (min-width: 768px) {
    .site-header__nav {
      display: block;
    }
  }

  .site-header__list {
    display: flex;
    gap: 0.25rem;
  }

  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.7rem;
    border-radius: var(--radius-pill);
    color: var(--color-body);
    font-weight: 600;
    font-size: 0.94rem;
    text-decoration: none;
  }

  .site-header__link:hover {
    background: var(--color-surface-sunken);
    text-decoration: none;
  }

  .site-header__link[aria-current='page'] {
    background: var(--color-brand-light);
    color: var(--color-brand-dark);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .site-header__search {
    gap: 0.4rem;
    padding-inline: 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    color: var(--color-body);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header__search:hover {
    background: var(--color-surface-sunken);
    text-decoration: none;
  }

  .site-header__search-text {
    display: none;
  }

  @media (min-width: 480px) {
    .site-header__search-text {
      display: inline;
    }
  }
</style>
