---
/**
 * The tag chips on a game detail page.
 *
 * WHY SOME CHIPS ARE LINKS AND SOME ARE NOT
 * -----------------------------------------
 * Tag pages are only generated once a tag clears
 * `SEO_THRESHOLDS.TAG_MIN_GAMES` (see `src/lib/seo/routing.ts`). Rendering
 * every tag as a link would therefore emit a dead link for every tag below the
 * threshold — which, on a young site, is all of them.
 *
 * Dropping the thin tags from the page instead would hide real, useful
 * information about the game. So both are rendered with the same visual
 * language and only the routed ones get an `<a>`. The moment a tag reaches the
 * threshold its chip becomes a link on every game that carries it, with no code
 * change.
 */
import { tagPath } from '@/lib/utils/url';

/** One tag as far as this component is concerned. */
export interface TagChip {
  /** Tag id, e.g. `no-download`. */
  id: string;
  /** Display name, e.g. `No Download`. */
  name: string;
  /** True when `/t/{id}/` was generated by this build. */
  routed: boolean;
}

export interface Props {
  /** Tags carried by this game, in authoring order. */
  tags: readonly TagChip[];
  /** Game name, used in the section heading. */
  gameTitle: string;
  /** Heading id so the section can be labelled. */
  headingId?: string;
}

const { tags, gameTitle, headingId = 'tags-heading' } = Astro.props;
---

{
  tags.length > 0 && (
    <section class="game-section" aria-labelledby={headingId} id="game-tags">
      <h2 class="game-section__title" id={headingId}>
        What kind of game {gameTitle} is
      </h2>

      <ul class="game-tags">
        {tags.map((tag) =>
          tag.routed ? (
            <li class="game-tags__item">
              <a class="game-tags__chip game-tags__chip--link tap-target" href={tagPath(tag.id)}>
                {tag.name}
              </a>
            </li>
          ) : (
            <li class="game-tags__item">
              <span class="game-tags__chip">{tag.name}</span>
            </li>
          ),
        )}
      </ul>
    </section>
  )
}

<style>
  .game-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .game-tags__item {
    display: inline-flex;
  }

  .game-tags__chip {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface-alt);
    color: var(--color-body);
    font-size: 0.88rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .game-tags__chip--link {
    color: var(--color-brand-dark);
    font-weight: 600;
  }

  .game-tags__chip--link:hover {
    background: var(--color-brand-light);
    border-color: var(--color-brand);
    text-decoration: none;
  }
</style>
