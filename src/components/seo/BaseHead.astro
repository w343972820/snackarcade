---
/**
 * Every meta tag the site emits, in one place.
 *
 * WHY ONE COMPONENT
 * -----------------
 * Canonical URLs, robots directives and Open Graph tags are the three things
 * most likely to silently disagree with each other across a growing site. Here
 * they are produced from the same inputs in the same file, so a page cannot
 * declare itself canonical in one tag and non-indexable in another.
 *
 * Title and description lengths are enforced by `resolveMeta`, which THROWS at
 * build time. An over-length title is a real, measurable click-through loss, so
 * the build refuses to produce one.
 */
import { SITE, absoluteUrl } from '@/config/site';
import { resolveMeta, truncate } from '@/lib/seo/meta';
import { getGameOrigin } from '@/lib/utils/gameUrl';
import { withTrailingSlash } from '@/lib/utils/url';

import AdsHead from '@/components/ads/AdsHead.astro';
import ConsentBootstrap from '@/components/consent/ConsentBootstrap.astro';

export interface Props {
  /** Page title without the brand suffix; the brand is appended if it fits. */
  title: string;
  /** Meta description, 70–158 characters. */
  description: string;
  /** Site-relative path of this page, used for the canonical URL. */
  pathname: string;
  /** Exact `<meta name="robots">` value, decided by `resolveIndexability`. */
  robots: string;
  /** Open Graph type. */
  ogType?: 'website' | 'article';
  /** Absolute or site-relative social image. Defaults to the site image. */
  ogImage?: string;
  /** Alt text for the social image. */
  ogImageAlt?: string;
  /** Overrides the computed canonical. Use only for deliberate consolidation. */
  canonicalOverride?: string | undefined;
  /** Article publish date, emitted for `og:type="article"`. */
  publishedAt?: Date | undefined;
  /** Article modification date. */
  updatedAt?: Date | undefined;
  /** Previous page URL for a paginated listing. */
  prevUrl?: string | undefined;
  /** Next page URL for a paginated listing. */
  nextUrl?: string | undefined;
  /** Where these values came from, so a length error names the right file. */
  source?: string;
}

const {
  title,
  description,
  pathname,
  robots,
  ogType = 'website',
  ogImage,
  ogImageAlt,
  canonicalOverride,
  publishedAt,
  updatedAt,
  prevUrl,
  nextUrl,
  source = 'unknown page',
} = Astro.props;

/** Throws with a plain-language message if a limit is broken. */
const meta = resolveMeta({ title, description, source });

const canonical: string =
  canonicalOverride !== undefined && canonicalOverride !== ''
    ? canonicalOverride
    : absoluteUrl(withTrailingSlash(pathname));

const socialImage: string = absoluteUrl(ogImage ?? SITE.defaultOgImage);
const socialImageAlt: string = ogImageAlt ?? `${SITE.name} — ${title}`;

/**
 * In external-origin mode the first thing the browser needs after HTML is a
 * connection to the game host. Preconnecting saves a full DNS + TLS round trip
 * on the slowest part of the page.
 */
const gameOrigin: string | null = getGameOrigin();
---

{/* Consent defaults must come before every other script on the page. */}
<ConsentBootstrap />

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

{prevUrl !== undefined && <link rel="prev" href={prevUrl} />}
{nextUrl !== undefined && <link rel="next" href={nextUrl} />}

{gameOrigin !== null && <link rel="preconnect" href={gameOrigin} crossorigin />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={truncate(meta.description, 200)} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={socialImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{
  ogType === 'article' && publishedAt !== undefined && (
    <meta property="article:published_time" content={publishedAt.toISOString()} />
  )
}
{
  ogType === 'article' && updatedAt !== undefined && (
    <meta property="article:modified_time" content={updatedAt.toISOString()} />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={truncate(meta.description, 200)} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />

<meta name="theme-color" content="#f97316" />
<meta name="format-detection" content="telephone=no" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{/* Ad network head tags. Emits nothing at all while ads are switched off. */}
<AdsHead />
