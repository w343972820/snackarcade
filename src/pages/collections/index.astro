---
/**
 * Collections index.  URL: /collections/
 *
 * A collection is a hand-picked set of games (e.g. "Best for a 5-minute break").
 * With no collections authored yet this renders a friendly empty state; the moment
 * one is added to src/content/collections it appears here, and a detail page is
 * generated by ./[slug].astro.
 */
import { getCollection } from 'astro:content';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { collectionPath } from '@/lib/utils/url';
import type { Crumb } from '@/lib/seo/breadcrumbs';

const collections = (await getCollection('collections')).sort(
  (a, b) => b.data.order - a.data.order || a.data.title.localeCompare(b.data.title),
);

const title = 'Game Collections';
const description =
  'Hand-picked sets of free browser games — themed collections like quick-session games or brain teasers, each with a full how-to-play guide.';
const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'Collections', href: '/collections/' },
];
---

<BaseLayout
  title={title}
  description={description}
  kind="collection"
  pathname="/collections/"
  itemCount={collections.length}
  source="src/pages/collections/index.astro"
>
  <div class="container-content collections-page">
    <Breadcrumbs crumbs={crumbs} class="collections-page__crumbs" />
    <h1>Game Collections</h1>
    <p class="collections-page__lead">
      Curated sets of games around a theme — a coffee break, a rainy afternoon, a brain workout. Each
      game links to its own written guide.
    </p>

    {
      collections.length === 0 ? (
        <p class="collections-page__empty">
          No collections yet — they are added as the library grows. In the meantime, browse all games
          from the menu.
        </p>
      ) : (
        <ul class="collections-page__list">
          {collections.map((collection) => (
            <li class="collections-page__item">
              <a href={collectionPath(collection.id)}>
                <span class="collections-page__name">{collection.data.title}</span>
                <span class="collections-page__count">
                  {collection.data.gameSlugs.length}{' '}
                  {collection.data.gameSlugs.length === 1 ? 'game' : 'games'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .collections-page {
    padding-block: 1rem 2rem;
  }
  .collections-page__crumbs {
    margin-block-end: 1rem;
  }
  .collections-page h1 {
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.2rem);
  }
  .collections-page__lead {
    margin-block: 0.5rem 1.5rem;
    color: var(--color-muted);
    max-width: 60ch;
  }
  .collections-page__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .collections-page__item a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface-alt);
    text-decoration: none;
    color: inherit;
  }
  .collections-page__item a:hover {
    border-color: var(--color-brand);
    text-decoration: none;
  }
  .collections-page__count {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .collections-page__empty {
    padding: 2rem 1rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-card);
    color: var(--color-muted);
  }
</style>
