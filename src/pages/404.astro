---
/**
 * Custom 404 page.  Served as /404.html on the static host.
 *
 * Every path that matches no real page (e.g. /games/tetris/, a mistyped URL)
 * receives this document with a true HTTP 404 status once SPA fallback is
 * turned off on Cloudflare Pages.
 *
 * SEO: the page is kind="utility", so `resolveIndexability` marks it noindex
 * and the sitemap filter drops /404/ — an error page must never compete with
 * the real content it sits in front of, and a soft-404 is exactly what Google
 * penalises.
 */
import { getGamesBySlugs } from '@/lib/content/games';
import { gamePath } from '@/lib/utils/url';

import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Page Not Found (404)';
const description =
  'The page you were looking for does not exist or has moved. Head back to the SnackArcade homepage or browse every free game we host.';

/**
 * Well-known, evergreen games — a useful escape hatch from a dead end. The
 * helper skips any slug that is missing, so this list can never break the build.
 */
const popularSlugs: readonly string[] = [
  'chess',
  '2048',
  'sudoku',
  'klondike-solitaire',
  'snake',
  'brick-breaker',
];
const popular = await getGamesBySlugs(popularSlugs);
---

<BaseLayout
  title={title}
  description={description}
  kind="utility"
  pathname="/404/"
  source="src/pages/404.astro"
>
  <div class="container-content not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 class="not-found__title">Page Not Found</h1>
    <p class="not-found__lead">
      The page you were looking for doesn’t exist, may have been moved, or the link you followed
      is out of date. Here are a few ways to get back on track.
    </p>

    <nav class="not-found__actions" aria-label="Useful pages">
      <a class="not-found__action not-found__action--primary tap-target" href="/">Back to Home</a>
      <a class="not-found__action tap-target" href="/all-games/">Browse All Games</a>
    </nav>

    {
      popular.length > 0 && (
        <section class="not-found__popular" aria-labelledby="not-found-popular-heading">
          <h2 id="not-found-popular-heading">Popular games you can play right now</h2>
          <ul class="not-found__list">
            {popular.map((game) => (
              <li class="not-found__item">
                <a class="not-found__link tap-target" href={gamePath(game.id)}>
                  {game.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: 40rem;
    padding-block: 3rem 4rem;
    text-align: center;
  }

  .not-found__code {
    margin: 0;
    font-size: clamp(3.5rem, 2rem + 8vw, 6rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-brand);
  }

  .not-found__title {
    margin-block-start: 0.75rem;
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.2rem);
  }

  .not-found__lead {
    margin-block: 0.75rem 1.75rem;
    margin-inline: auto;
    color: var(--color-muted);
    max-width: 40ch;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .not-found__action {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface-alt);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .not-found__action:hover {
    border-color: var(--color-brand);
    background: var(--color-brand-light);
    text-decoration: none;
  }

  .not-found__action--primary {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #fff;
  }

  .not-found__action--primary:hover {
    background: var(--color-brand-dark);
    border-color: var(--color-brand-dark);
  }

  .not-found__popular {
    margin-block-start: 3rem;
  }

  .not-found__popular h2 {
    font-size: 1.15rem;
    color: var(--color-ink);
  }

  .not-found__list {
    list-style: none;
    padding: 0;
    margin-block-start: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .not-found__link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface-alt);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .not-found__link:hover {
    border-color: var(--color-brand);
    background: var(--color-brand-light);
    text-decoration: none;
  }
</style>
