---
/**
 * Blog post.  URL: /blog/{slug}/
 *
 * getStaticPaths emits one route per non-draft post in src/content/blog. With no
 * posts authored the index page shows its empty state and nothing is generated here.
 *
 * Two blocks sit below the body. "Related Posts" (driven by src/lib/related/posts.ts)
 * links to sibling posts so the blog section has its own internal-link network;
 * it is not rendered when no sibling shares a signal. "Related Games" is driven
 * by `relatedGameSlugs` in the post frontmatter; when the list is empty the
 * block is not rendered at all.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

import ArticleLayout from '@/layouts/ArticleLayout.astro';
import GameGrid from '@/components/ui/GameGrid.astro';
import PostCard from '@/components/ui/PostCard.astro';
import { getRelatedGames, getRelatedPosts } from '@/lib/content/blog';
import { pageBreadcrumbs } from '@/lib/seo/breadcrumbs';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', (post) => import.meta.env.DEV || !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { slug: post.id },
  }));
}) satisfies GetStaticPaths;

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const entry = (await getCollection('blog')).find((p) => p.id === slug);
if (!entry) return Astro.notFound();

const data = entry.data;
const crumbs = pageBreadcrumbs(data.title, `/blog/${slug}/`);
const pathname = `/blog/${slug}/`;

const relatedGames = await getRelatedGames(entry);
const relatedPosts = await getRelatedPosts(entry);

const { Content } = await render(entry);
---

<ArticleLayout
  title={data.seo.title}
  description={data.seo.description}
  kind="blog"
  h1={data.title}
  crumbs={crumbs}
  pathname={pathname}
  itemCount={1}
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  source={`src/pages/blog/${slug}.astro`}
  showAds={false}
>
  <Content />

  {
    relatedPosts.length > 0 && (
      <section class="blog-post__related" aria-labelledby="related-posts-heading">
        <h2 id="related-posts-heading">Related Posts</h2>
        <p class="blog-post__related-sub">
          More guides, tips and game round-ups from the blog.
        </p>
        <ul class="blog-post__related-list">
          {relatedPosts.map((post) => (
            <PostCard post={post} headingLevel="h3" />
          ))}
        </ul>
      </section>
    )
  }

  {
    relatedGames.length > 0 && (
      <section class="blog-post__related" aria-labelledby="related-games-heading">
        <h2 id="related-games-heading">Related Games</h2>
        <p class="blog-post__related-sub">
          The games this post talks about — each with a full guide and controls.
        </p>
        <GameGrid games={relatedGames} eagerCount={0} headingLevel="h3" />
      </section>
    )
  }
</ArticleLayout>

<style>
  .blog-post__related {
    margin-block-start: 3rem;
    padding-block-start: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .blog-post__related h2 {
    font-size: 1.3rem;
  }

  .blog-post__related-sub {
    margin-block: 0.3rem 1.1rem;
    color: var(--color-muted);
  }

  .blog-post__related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .blog-post__related-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
