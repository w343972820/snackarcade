---
/**
 * Blog index.  URL: /blog/
 *
 * Empty-state first: with no posts in src/content/blog the page explains itself
 * rather than looking broken. Each post renders through ./[slug].astro.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import PostCard from '@/components/ui/PostCard.astro';
import { getPublishedPosts } from '@/lib/content/blog';
import type { Crumb } from '@/lib/seo/breadcrumbs';

const posts = await getPublishedPosts();

const title = 'Blog';
const description =
  'Guides, tips and behind-the-scenes notes about the free browser games on SnackArcade — how they are built and how to play them well.';
const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
];
---

<BaseLayout
  title={title}
  description={description}
  kind="blog"
  pathname="/blog/"
  itemCount={posts.length}
  source="src/pages/blog/index.astro"
>
  <div class="container-content blog-index">
    <Breadcrumbs crumbs={crumbs} class="blog-index__crumbs" />
    <h1>Blog</h1>
    <p class="blog-index__lead">Tips, build notes and how-to guides for the games on this site.</p>

    {
      posts.length === 0 ? (
        <p class="blog-index__empty">No posts yet — check back soon.</p>
      ) : (
        <ul class="blog-index__list">
          {posts.map((post) => (
            <PostCard post={post} headingLevel="h2" />
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .blog-index {
    padding-block: 1rem 2rem;
  }
  .blog-index__crumbs {
    margin-block-end: 1rem;
  }
  .blog-index h1 {
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.2rem);
  }
  .blog-index__lead {
    margin-block: 0.5rem 1.5rem;
    color: var(--color-muted);
  }
  .blog-index__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 639px) {
    .blog-index__list {
      grid-template-columns: 1fr;
    }
  }
  .blog-index__empty {
    padding: 2rem 1rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-card);
    color: var(--color-muted);
  }
</style>
