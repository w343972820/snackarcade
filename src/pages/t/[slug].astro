---
/**
 * Tag listing — page 1.  URL: /t/{slug}/
 *
 * A tag page is generated ONLY when the tag clears
 * `SEO_THRESHOLDS.TAG_MIN_GAMES`. Anything below that used to be built and then
 * marked `noindex`, which produced a pile of orphan pages nobody linked to and
 * that still had to be excluded from the sitemap by hand. Now the rule is
 * binary: generated and indexable, or not generated at all.
 *
 * The chips on a game detail page follow the same predicate, so a tag below the
 * threshold renders as plain text rather than a link to a page that is not
 * there. Paginated pages live in ./[slug]/page/[page].astro.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import { getPublishedGames } from '@/lib/content/games';
import { tagPath, tagPagePath } from '@/lib/utils/url';
import { tagBreadcrumbs } from '@/lib/seo/breadcrumbs';
import { countTagOccurrences, shouldGenerateTagPage } from '@/lib/seo/routing';
import { itemListSchema } from '@/components/seo/schema/itemList';
import { breadcrumbListSchema } from '@/components/seo/schema/breadcrumbList';
import { PAGE_SIZES } from '@/config/seo';

import GameListing from '@/components/listings/GameListing.astro';

export const getStaticPaths = (async () => {
  const tags = await getCollection('tags');
  const games = await getPublishedGames();

  const counts = countTagOccurrences(games.map((game) => game.data.taxonomy.tags));

  return tags
    .filter((tag) => shouldGenerateTagPage(counts.get(tag.id) ?? 0, tag.data.forceNoindex))
    .map((tag) => {
      const totalPages = Math.max(1, Math.ceil((counts.get(tag.id) ?? 0) / PAGE_SIZES.TAG));
      return {
        params: { slug: tag.id },
        props: { tagId: tag.id, pageNumber: 1, totalPages },
      };
    });
}) satisfies GetStaticPaths;

interface Props {
  tagId: string;
  pageNumber: number;
  totalPages: number;
}

const { tagId, pageNumber, totalPages } = Astro.props;

const tagEntry = (await getCollection('tags')).find((t) => t.id === tagId);
if (!tagEntry) return Astro.notFound();

const allGames = await getPublishedGames();
const tagGames = allGames.filter((g) => g.data.taxonomy.tags.includes(tagId));
const total = tagGames.length;

const size = PAGE_SIZES.TAG;
const start = (pageNumber - 1) * size;
const pageGames = tagGames.slice(start, start + size);

const name = tagEntry.data.name;
const title = `Free ${name} Games to Play Online`;
const description = tagEntry.data.description;

const crumbs = tagBreadcrumbs(name, tagId);
const pathname = pageNumber > 1 ? tagPagePath(tagId, pageNumber) : tagPath(tagId);

const jsonLd = [
  breadcrumbListSchema(crumbs),
  itemListSchema(
    pageGames.map((g) => ({ slug: g.id, title: g.data.title })),
    `${name} Games`,
    start + 1,
  ),
];

const hrefFor = (page: number) => tagPagePath(tagId, page);
---

<GameListing
  kind="tag"
  title={title}
  description={description}
  h1={`${name} Games`}
  crumbs={crumbs}
  games={pageGames}
  pageNumber={pageNumber}
  totalPages={totalPages}
  hrefFor={hrefFor}
  pathname={pathname}
  itemCount={pageGames.length}
  jsonLdNodes={jsonLd}
  source={`src/pages/t/${tagId}.astro`}
  lede={`${total} ${total === 1 ? 'game' : 'games'} tagged "${name}".`}
  emptyMessage="No games with this tag yet."
>
  <Fragment slot="intro"><p>{tagEntry.data.description}</p></Fragment>
</GameListing>
