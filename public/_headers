/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), geolocation=(), microphone=(), camera=()
  X-Frame-Options: SAMEORIGIN

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/search-index.json
  Cache-Control: public, max-age=3600

/licenses.json
  Cache-Control: public, max-age=3600

# Locally served game bundles (only present when PUBLIC_GAME_ORIGIN is unset).
# These live under /play/ so they never collide with the /games/{slug}/ article
# pages. Bundles are versioned by directory, so they are safe to cache hard.
/play/*
  Cache-Control: public, max-age=31536000, immutable
