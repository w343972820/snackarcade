# Google Search Console is usually given /sitemap.xml. Astro emits a sharded
# index at /sitemap-index.xml, so serve that content at the friendlier path.
/sitemap.xml   /sitemap-index.xml   200

# Common mistyped or legacy paths.
/game/*        /games/:splat        301
/category/*    /c/:splat            301
/tag/*         /t/:splat            301
/privacy       /privacy-policy/     301
/tos           /terms/              301

# Bare and legacy paths Google has crawled and reported as 404 in Search Console.
# /games/ is the natural parent of /games/{slug}/ a visitor may type; /all-games/
# is the real listing. /games/tetris/ was crawled on 2026-08-22 — the site hosts
# no Tetris, and Block Drop is the Tetris-style game (canvas-tetris source), so
# that is where the request is sent.
/games/         /all-games/         301
/games/tetris/  /games/block-drop/  301

# A typo'd slug that shipped in memory-match-tips and was linked for five days
# before being corrected. Google crawled it, so 301 it to the real post rather
# than leaving a dead end.
/blog/sudoku-strategy/  /blog/sudoku-strategies-for-beginners/  301

https://www.playsnackarcade.com/* https://playsnackarcade.com/:splat 301
http://www.playsnackarcade.com/* https://playsnackarcade.com/:splat 301
