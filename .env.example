# =============================================================================
# SnackArcade — environment variables
# Copy this file to `.env` and fill in the values you actually have.
# EVERY variable here is optional. With an empty .env the site still builds
# and every game still works (served from your own site).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. PUBLIC_SITE_URL  — your domain
# -----------------------------------------------------------------------------
# Used for canonical URLs, sitemap, Open Graph images and structured data.
# No trailing slash.
#
# Leave it unset while developing locally. Set it on Cloudflare Pages as soon
# as you have a domain, otherwise Google will see the placeholder domain.
#
PUBLIC_SITE_URL=https://snackarcade.com


# -----------------------------------------------------------------------------
# 2. PUBLIC_GAME_ORIGIN  — where the playable game files live
# -----------------------------------------------------------------------------
# WHEN YOU CAN IGNORE THIS (this is the default, and it is fine):
#   Leave it EMPTY / delete the line. Games are then served from your own
#   site at /play/{slug}/. Everything works, nothing extra to buy or set up.
#   This is the recommended setting until you have thousands of games.
#   (/play/ is the playable file. /games/{slug}/ is the page people read.)
#
# WHEN YOU NEED TO SET IT:
#   Cloudflare Pages allows max 20,000 files per deploy. Each game is roughly
#   10-40 files. Run `npm run build` and read the budget report printed at the
#   end. Once it says you are above ~60%, move the games to Cloudflare R2:
#
#     1. Create a Cloudflare R2 bucket (free tier: 10 GB).
#     2. Attach a custom domain to it, e.g. play.snackarcade.com
#     3. Run: npm run publish:games
#     4. Set the variable below and redeploy.
#
#   No trailing slash. Must be a different domain from your main site —
#   that is what makes the iframe sandbox actually protect your site.
#
# PUBLIC_GAME_ORIGIN=https://play.snackarcade.com


# -----------------------------------------------------------------------------
# 3. PUBLIC_ADSENSE_PUB_ID  — your AdSense publisher ID
# -----------------------------------------------------------------------------
# Format: ca-pub- followed by exactly 16 digits.
#
# Ads are OFF by default (src/config/ads.ts -> enabled: false), which is the
# correct state while your AdSense application is under review: an approved
# site should show real content, not empty ad boxes.
#
# After AdSense approves you:
#   1. Paste your publisher ID here.
#   2. Open src/config/ads.ts and set `enabled: true`.
#   3. Redeploy.
#
# NOTE: /ads.txt is generated from this value and should be online BEFORE you
# submit for review. Set this variable early even while enabled stays false.
#
# PUBLIC_ADSENSE_PUB_ID=ca-pub-0000000000000000


# -----------------------------------------------------------------------------
# 4. PUBLIC_GA4_ID  — Google Analytics 4 measurement ID
# -----------------------------------------------------------------------------
# Format: G- followed by 10 characters. Leave empty to ship zero analytics
# scripts (the site is faster and needs a simpler cookie banner without it).
#
# PUBLIC_GA4_ID=G-XXXXXXXXXX


# -----------------------------------------------------------------------------
# 5. R2 upload credentials — ONLY needed for `npm run publish:games`
# -----------------------------------------------------------------------------
# Never commit real values. These are read by wrangler, not by the website.
#
# CLOUDFLARE_ACCOUNT_ID=
# R2_BUCKET=snackarcade-games
